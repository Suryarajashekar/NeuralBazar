# Shared deployment defaults
CHAIN_ID=11155111
NETWORK_NAME=sepolia

# Smart contracts / Hardhat
PRIVATE_KEY=replace_with_a_deployer_wallet_private_key
RPC_URL=https://sepolia.infura.io/v3/replace_with_project_id
ETHERSCAN_API_KEY=replace_with_etherscan_api_key
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
PLATFORM_TREASURY=0x0000000000000000000000000000000000000000

# Backend
PORT=4000
DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_marketplace
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:3000
# Set this to the approved admin wallet in production; leave blank only for local first-admin bootstrap.
ADMIN_WALLET_ADDRESS=
BACKEND_PUBLIC_URL=http://localhost:4000
INDEXER_START_BLOCK=0
REGISTRY_ADDRESS=
MARKETPLACE_ADDRESS=
ACCESS_MANAGER_ADDRESS=
BACKEND_SIGNER_PRIVATE_KEY=replace_with_backend_signer_private_key

# Pinata IPFS
PINATA_JWT=replace_with_pinata_jwt
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/replace_with_project_id
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace_with_walletconnect_project_id
NEXT_PUBLIC_CONTRACT_ADDRESS_REGISTRY=
NEXT_PUBLIC_CONTRACT_ADDRESS_MARKETPLACE=
NEXT_PUBLIC_CONTRACT_ADDRESS_ACCESS=
