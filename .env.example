# Shared deployment defaults
CHAIN_ID=11155111
NETWORK_NAME=sepolia

# Smart contracts / Hardhat
PRIVATE_KEY=replace_with_a_deployer_wallet_private_key
RPC_URL=https://sepolia.infura.io/v3/replace_with_project_id
ETHERSCAN_API_KEY=replace_with_etherscan_api_key
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
PLATFORM_TREASURY=0x0000000000000000000000000000000000000000

# Backend
PORT=4000
DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_marketplace
JWT_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_IDLE_TIMEOUT_MINUTES=30
TRUST_PROXY=1
REQUEST_SIGNING_MAX_SKEW_SECONDS=300
API_KEYS=
FRONTEND_URL=http://localhost:3000
# Set this to the approved admin wallet in production; leave blank only for local first-admin bootstrap.
ADMIN_WALLET_ADDRESS=
BACKEND_PUBLIC_URL=http://localhost:4000
INDEXER_START_BLOCK=0
REGISTRY_ADDRESS=
MARKETPLACE_ADDRESS=
ACCESS_MANAGER_ADDRESS=
BACKEND_SIGNER_PRIVATE_KEY=replace_with_backend_signer_private_key

# Pinata IPFS
PINATA_JWT=replace_with_pinata_jwt
# Optional separate gateway JWT; ciphertext remains encrypted even if the gateway is public.
PINATA_GATEWAY_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
MODEL_ENCRYPTION_KEY=generate_a_base64_32_byte_key
CLAMAV_PATH=/usr/bin/clamscan
MODEL_SIGNING_PRIVATE_KEY=replace_with_ed25519_private_key_pem
MODEL_SIGNING_PUBLIC_KEY=replace_with_ed25519_public_key_pem
MODEL_SECURITY_SCORE_THRESHOLD=80
BENCHMARK_RUNNER_PATH=
EMBEDDING_MODEL=local-hash-v1

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/replace_with_project_id
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace_with_walletconnect_project_id
NEXT_PUBLIC_CONTRACT_ADDRESS_REGISTRY=
NEXT_PUBLIC_CONTRACT_ADDRESS_MARKETPLACE=
NEXT_PUBLIC_CONTRACT_ADDRESS_ACCESS=

# V2 contract governance
GOVERNANCE_MULTISIG=
BACKEND_GRANTER_ADDRESS=
EMERGENCY_PAUSER_ADDRESS=
TIMELOCK_DELAY_SECONDS=86400
