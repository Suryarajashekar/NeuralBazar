PORT=4000
NODE_ENV=development
DATABASE_SSL=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_marketplace
JWT_SECRET=use-a-long-random-value
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_IDLE_TIMEOUT_MINUTES=30
TRUST_PROXY=1
REQUEST_SIGNING_MAX_SKEW_SECONDS=300
# Optional machine credentials: id:32+char-secret:subject:wallet:role (comma-separated).
API_KEYS=
FRONTEND_URL=http://localhost:3000
# Set this to the approved admin wallet in production; leave blank only for local first-admin bootstrap.
ADMIN_WALLET_ADDRESS=
BACKEND_PUBLIC_URL=http://localhost:4000
RPC_URL=https://sepolia.infura.io/v3/your-project-id
CHAIN_ID=11155111
INDEXER_START_BLOCK=0
REGISTRY_ADDRESS=
MARKETPLACE_ADDRESS=
ACCESS_MANAGER_ADDRESS=
BACKEND_SIGNER_PRIVATE_KEY=
PINATA_JWT=
# Optional separate JWT for a private Pinata gateway; the pinning JWT is used if blank.
PINATA_GATEWAY_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MODEL_ENCRYPTION_KEY=
# Absolute path to clamscan. If blank, the built-in heuristic scanner is used.
CLAMAV_PATH=
MODEL_SIGNING_PRIVATE_KEY=
MODEL_SIGNING_PUBLIC_KEY=
MODEL_SECURITY_SCORE_THRESHOLD=80
BENCHMARK_RUNNER_PATH=
EMBEDDING_MODEL=local-hash-v1
# Uploads are staged on disk and streamed to Pinata. Increase only with a measured worker/storage plan.
MAX_UPLOAD_BYTES=268435456
# Optional absolute path for staged uploads; defaults to the operating system temp directory.
UPLOAD_TEMP_DIR=
